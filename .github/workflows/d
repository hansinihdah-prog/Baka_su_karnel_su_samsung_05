name: Build Kernel A05 + BakaSU (ex-ReSukiSU)

on:
  workflow_dispatch:
    inputs:
      kernel_repo:
        description: "Repo source kernel"
        default: "https://github.com/rsuntk/android_kernel_samsung_a05m-6.6"
      kernel_branch:
        description: "Branch source kernel"
        default: "android15-6.6-lts"
      susfs:
        description: "Pasang SUSFS (true/false). true = mode SUSFS inline hook, false = hook manual biasa"
        default: "true"
      susfs_repo:
        description: "Repo SUSFS (branch gki-android15-6.6)"
        default: "https://github.com/ShirkNeko/susfs4ksu"
      susfs_ref:
        description: "Commit/branch SUSFS. ebf876e = versi yang cocok dengan BakaSU sync-susfs (yang lebih baru memanggil fungsi yang belum ada di BakaSU)"
        default: "ebf876e"
      config_mode:
        description: "gki = gki_defconfig (cocok modul vendor), stock = a05m-stock_defconfig"
        default: "gki"
      uname_r:
        description: "Hasil 'uname -r' dari HP (opsional, supaya modul stok cocok). Contoh: 6.6.142-android15-8-xxxx"
        default: ""

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 240
    steps:
      - name: Checkout (ambil patch_hooks.py)
        uses: actions/checkout@v4

      - name: Kosongkan disk runner
        run: |
          sudo rm -rf /usr/share/dotnet /usr/local/lib/android /opt/ghc /opt/hostedtoolcache/CodeQL /usr/local/share/boost
          df -h /

      - name: Install dependensi build
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends \
            build-essential bc bison flex libssl-dev libelf-dev libncurses-dev \
            clang-18 lld-18 llvm-18 dwarves cpio rsync lz4 xz-utils zip unzip \
            python3 git curl ca-certificates
          clang-18 --version | head -1

      - name: Clone source kernel
        run: |
          git clone --depth=1 -b "${{ inputs.kernel_branch }}" "${{ inputs.kernel_repo }}" kernel
          cd kernel && make kernelversion 2>/dev/null || grep -m4 -E '^(VERSION|PATCHLEVEL|SUBLEVEL)' Makefile

      - name: Tambah BakaSU (setup.sh)
        working-directory: kernel
        run: |
          if [ "${{ inputs.susfs }}" = "true" ]; then REF=sync-susfs; else REF=main; fi
          echo "BakaSU ref: $REF"
          curl -LSs "https://raw.githubusercontent.com/Baka-SU/BakaSU/main/kernel/setup.sh" | bash -s -- "$REF"
          git -C KernelSU log -1 --format='BakaSU commit: %h %cd %s' 
          ls -la drivers | grep -i kernelsu
          grep -n kernelsu drivers/Makefile drivers/Kconfig

      - name: Pasang hook manual
        if: ${{ inputs.susfs != 'true' }}
        run: python3 -I patch_hooks.py "$GITHUB_WORKSPACE/kernel"

      - name: Pasang SUSFS (hook inline SUSFS, tanpa hook manual)
        if: ${{ inputs.susfs == 'true' }}
        run: |
          git clone -b gki-android15-6.6 "${{ inputs.susfs_repo }}" susfs4ksu
          git -C susfs4ksu checkout "${{ inputs.susfs_ref }}"
          git -C susfs4ksu log -1 --format='SUSFS commit: %h %cd %s'
          python3 -I patch_hooks.py "$GITHUB_WORKSPACE/kernel" --only-cert
          python3 -I patch_susfs.py "$GITHUB_WORKSPACE/kernel" "$GITHUB_WORKSPACE/susfs4ksu"
          grep -m1 "define SUSFS_VERSION" kernel/include/linux/susfs.h

      - name: Atur defconfig
        working-directory: kernel
        run: |
          if [ "${{ inputs.config_mode }}" = "gki" ]; then BASE=gki_defconfig; else BASE=a05m-stock_defconfig; fi
          DEF=arch/arm64/configs/$BASE
          echo "Config dasar: $BASE"
          # path signing key bawaan menunjuk ke mesin Samsung/MTK, ganti ke default
          sed -i '/^CONFIG_MODULE_SIG_KEY=/d' $DEF
          # opsi yang kita atur (baris terakhir menang)
          {
            echo ""
            echo "# BakaSU"
            echo "CONFIG_KSU=y"
            if [ "${{ inputs.susfs }}" = "true" ]; then
              echo "CONFIG_KSU_SUSFS=y"
              echo "# CONFIG_KSU_MANUAL_HOOK is not set"
            else
              echo "CONFIG_KSU_MANUAL_HOOK=y"
            fi
            echo 'CONFIG_MODULE_SIG_KEY="certs/signing_key.pem"'
            echo "# CONFIG_LOCALVERSION_AUTO is not set"
            echo "# CONFIG_SECURITY_DEFEX is not set"
            if [ "$BASE" = "gki_defconfig" ]; then
              # kernel ROM stok tidak punya io_uring (mengubah struct task_struct & CRC modul)
              echo "# CONFIG_BLK_DEV_UBLK is not set"   # ublk memaksa IO_URING menyala
              echo "# CONFIG_IO_URING is not set"
            fi
          } >> $DEF
          if [ -n "${{ inputs.uname_r }}" ] && [ "$BASE" != "gki_defconfig" ]; then
            SUFFIX="${{ inputs.uname_r }}"
            SUFFIX="${SUFFIX#6.6.142}"
            sed -i '/^CONFIG_LOCALVERSION=/d' $DEF
            echo "CONFIG_LOCALVERSION=\"$SUFFIX\"" >> $DEF
          fi
          export ARCH=arm64 LLVM=-18 LLVM_IAS=1
          make O=out $BASE
          echo "--- cek opsi penting ---"
          grep -E '^(# )?CONFIG_(IO_URING|BLK_DEV_UBLK|SHADOW_CALL_STACK|CFI_CLANG|NETFILTER_XTABLES_COMPAT|CONNECTOR|ANDROID_WRAPFD)[= ]' out/.config
          grep -E '^CONFIG_(KSU|KSU_SUSFS|KSU_SUSFS_[A-Z_]+|KSU_MANUAL_HOOK|KSU_MANUAL_HOOK_AUTO_[A-Z]+|KALLSYMS_ALL|SECURITY_DEFEX|LOCALVERSION)=' out/.config
          if [ "$BASE" = "gki_defconfig" ] && grep -q '^CONFIG_IO_URING=y' out/.config; then echo "IO_URING masih aktif, ada opsi lain yang memaksa"; exit 1; fi
          grep -q '^CONFIG_KSU=y' out/.config || { echo "KSU tidak aktif di .config"; exit 1; }
          if [ "${{ inputs.susfs }}" = "true" ]; then
            grep -q '^CONFIG_KSU_SUSFS=y' out/.config || { echo "KSU_SUSFS tidak aktif"; exit 1; }
          else
            grep -q '^CONFIG_KSU_MANUAL_HOOK=y' out/.config || { echo "MANUAL_HOOK tidak aktif"; exit 1; }
          fi

      - name: Build kernel
        working-directory: kernel
        run: |
          export ARCH=arm64 LLVM=-18 LLVM_IAS=1
          if ! make O=out -j"$(nproc)" -k Image > ../build.log 2>&1; then
            echo "=============== BUILD GAGAL: cuplikan error pertama ==============="
            grep -n -m1 -B12 -A25 -E "error:|undefined (reference|symbol)|\*\*\* \[[^]]*\.(o|a)\]|fatal error|ERROR" ../build.log || true
            echo "=============== 60 baris terakhir ==============="
            tail -n 60 ../build.log
            exit 1
          fi
          test -f out/arch/arm64/boot/Image

      - name: Cek CRC simbol vs modul vendor stok
        shell: bash
        run: |
          set +e
          python3 -I tools/cekcrc.py kernel/out/arch/arm64/boot/Image tools/stock_modver.json > crc.log 2>&1
          RC=$?
          cat crc.log
          if [ $RC -ne 0 ]; then
            echo "::error::CRC tidak cocok dengan modul vendor -> kernel ini akan bootloop. Zip TIDAK dibuat."
            exit 1
          fi

      - name: Bungkus zip AnyKernel3
        run: |
          KVER=$(make -s -C kernel O=out kernelrelease ARCH=arm64 LLVM=-18 2>/dev/null || echo unknown)
          echo "KVER=$KVER" >> "$GITHUB_ENV"
          git clone --depth=1 https://github.com/osm0sis/AnyKernel3 ak3
          rm -rf ak3/.git ak3/.github ak3/README.md ak3/modules ak3/patch ak3/ramdisk
          cp kernel/out/arch/arm64/boot/Image ak3/Image
          cat > ak3/anykernel.sh <<'EOF'
          ### AnyKernel3 - Galaxy A05 (a05m) + BakaSU
          properties() { '
          kernel.string=Galaxy A05 kernel 6.6 + BakaSU
          do.devicecheck=0
          do.modules=0
          do.systemless=0
          do.cleanup=1
          do.cleanuponabort=0
          device.name1=a05m
          device.name2=SM-A055F
          supported.versions=
          supported.patchlevels=
          supported.vendorpatchlevels=
          '; }
          BLOCK=boot;
          IS_SLOT_DEVICE=0;
          RAMDISK_COMPRESSION=auto;
          PATCH_VBMETA_FLAG=auto;
          . tools/ak3-core.sh;
          split_boot;
          flash_boot;
          EOF
          cd ak3 && zip -r9 "../A05-BakaSU-${KVER}.zip" . -x '*.git*' && cd ..
          ls -la *.zip

      - name: Upload hasil
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: A05-BakaSU-kernel
          path: |
            A05-BakaSU-*.zip
            kernel/out/arch/arm64/boot/Image
            build.log
            crc.log
          if-no-files-found: warn
